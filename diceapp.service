[Unit]
Description=Dice Roll Flask App
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/dice
Environment="PATH=/usr/local/bin:/usr/bin:/home/ec2-user/.local/bin"
Environment="PYTHONPATH=/home/ec2-user/dice"
ExecStart=/home/ec2-user/.local/bin/gunicorn -w 4 -b 127.0.0.1:5000 app.flask_app:app
Restart=always

[Install]
WantedBy=multi-user.target
